@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix tpl: <https://bg-rdf.org/templates/> .

@prefix : <#> .

# Gut (BVC-RAAS5): water and Na taken in to the lumen and some lost in faeces; water absorbed one way by the
# osmotic difference between the circulation and the lumen; Na into the epithelium one way, in proportion to the
# difference of the amounts, and pumped one way from it to the circulation by an aldosterone-scaled Na/K-ATPase.
# (The circulation's Na concentration for its osmotic pressure is taken per 1000 L, as in the original model.)

:BVC_GI_Beulens2026_v01
    a bgf:BondgraphModel ;
    bgf:usesTemplate tpl:chemical.ttl, tpl:hydraulic.ttl, tpl:signal.ttl ;
    bgf:hasBondElement :giIn_W, :gi_W, :giOut_W, :abs_W, :giIn_Na, :gi_Na, :giOut_Na, :J_gi, :giEpi_Na, :NKE ;
    bgf:hasSignalBlock :q_vc_Na, :q_vc_W, :q_aldo, :aldo_scale, :q_vc_K, :q_giEpi_K, :q_giEpi_W,
        :c_gi_Na, :c_giEpi_Na, :c_giEpi_K, :c_vc_Na_L, :c_vc_Na, :c_vc_K, :u_gi_osmotic, :u_vc_osmotic,
        :du_osm_gi, :v_gi_W_osm, :v_gi_W_max, :dq_gi_Na, :v_gi_Na_lin, :v_gi_Na_max ;
    bgf:hasSignalBond :s01, :s02, :s03, :s04, :s05, :s06, :s07, :s08, :s09, :s10,
        :s11, :s12, :s13, :s14, :s15, :s16, :s17, :s18, :s19, :s20,
        :s21, :s22, :s23, :s24, :s25, :s26, :s27, :s28, :s29 .

#===============================================================================
# Water

:giIn_W a bgf:HydraulicFlow ; bgf:hasSymbol "v_giIn_W" ; bgf:hasValue "0 L/s"^^cdt:ucum .

:gi_W a bgf:HydraulicStorageNode ;
    bgf:hasSymbol "q_gi_W" ;
    bgf:hasValue "0.289 L"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "E" ; bgf:hasSymbol "E_gi_W" ; bgf:hasValue "1 J"^^cdt:ucum ] .

:giOut_W a bgf:HydraulicFlow ; bgf:hasSymbol "v_giOut_W" ; bgf:hasValue "0 L/s"^^cdt:ucum .

# absorbed to the blood, one way, by the osmotic difference
:abs_W a bgf:HydraulicFlow ;
    bgf:hasSymbol "v_gi_W" ;
    bgf:portType "blood_uptake_port" ; bgf:portVariables "v" .

:w1 bgf:hasSource :giIn_W ; bgf:hasTarget :gi_W .
:w2 bgf:hasSource :gi_W ; bgf:hasTarget :giOut_W .
:w3 bgf:hasSource :gi_W ; bgf:hasTarget :abs_W .

#===============================================================================
# Na

:giIn_Na a bgf:ChemicalFlow ; bgf:hasSymbol "v_giIn_Na" ; bgf:hasValue "0 mol/s"^^cdt:ucum .

:gi_Na a bgf:ChemicalStorageNode ;
    bgf:hasSymbol "q_gi_Na" ;
    bgf:hasValue "0.001444 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasSymbol "K_gi_Na" ; bgf:hasValue "1 mol-1"^^cdt:ucum ] .

:giOut_Na a bgf:ChemicalFlow ; bgf:hasSymbol "v_giOut_Na" ; bgf:hasValue "0 mol/s"^^cdt:ucum .

:J_gi a bgf:SignalFluxNode ; bgf:hasSymbol "v_gi_Na" .

:giEpi_Na a bgf:ChemicalStorageNode ;
    bgf:hasSymbol "q_giEpi_Na" ;
    bgf:hasValue "0.0015 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasSymbol "K_giEpi_Na" ; bgf:hasValue "1 mol-1"^^cdt:ucum ] .

:NKE a bgf:NKEPumpNode ;
    bgf:hasSymbol "v_giEpi_NKE" ;
    bgf:oneWay true ;
    bgf:portType "GI_sodium_flux_port" ; bgf:multiPort "True" ;
    bgf:parameterValue [ bgf:varName "k_NKE" ; bgf:hasSymbol "k_giEpi_NKE" ; bgf:hasValue "100000 mol/s"^^cdt:ucum ] ,
                       [ bgf:varName "K_ATP" ; bgf:hasSymbol "K_ATP" ; bgf:hasValue "1 1"^^cdt:ucum ] ,
                       [ bgf:varName "K_Na" ; bgf:hasSymbol "K_Na" ; bgf:hasValue "1 L/mol"^^cdt:ucum ] ,
                       [ bgf:varName "K_K" ; bgf:hasSymbol "K_K" ; bgf:hasValue "1 L/mol"^^cdt:ucum ] ,
                       [ bgf:varName "u_e" ; bgf:hasSymbol "u_giEpi_e" ; bgf:hasValue "-0.04 J/C"^^cdt:ucum ] ,
                       [ bgf:varName "RT" ; bgf:hasValue "2577 J/mol"^^cdt:ucum ] .

:n1 bgf:hasSource :giIn_Na ; bgf:hasTarget :gi_Na .
:n2 bgf:hasSource :gi_Na ; bgf:hasTarget :giOut_Na .
:n3 bgf:hasSource :gi_Na ; bgf:hasTarget :J_gi .
:n4 bgf:hasSource :J_gi ; bgf:hasTarget :giEpi_Na .
:n5 bgf:hasSource :giEpi_Na ; bgf:hasTarget :NKE .

#===============================================================================
# Signals

:q_vc_Na a bgf:SignalInputPort ; bgf:hasSymbol "q_vc_Na" ;
    bgf:portType "circulation_Na_port" ; bgf:multiPort "True" ; bgf:hasValue "0.217157 mol"^^cdt:ucum .
:q_vc_W a bgf:SignalInputPort ; bgf:hasSymbol "q_vc_W" ;
    bgf:portType "osmotic_vol_port" ; bgf:hasValue "1.06921 L"^^cdt:ucum .
:q_aldo a bgf:SignalInputPort ; bgf:hasSymbol "q_aldo" ;
    bgf:portType "aldosterone_port" ; bgf:hasValue "2.1133e-08 mol"^^cdt:ucum .

:aldo_scale a bgf:SaturatingScale ;
    bgf:hasSymbol "aldo_scale" ;
    bgf:parameterValue [ bgf:varName "alpha" ; bgf:hasSymbol "alpha_aldo" ; bgf:hasValue "1 1"^^cdt:ucum ] ,
                       [ bgf:varName "u_half" ; bgf:hasSymbol "aldo_healthy" ; bgf:hasValue "1.13e-09 mol"^^cdt:ucum ] .

:q_vc_K a bgf:Constant ; bgf:hasSymbol "q_vc_K" ; bgf:hasValue "0.014 mol"^^cdt:ucum .
:q_giEpi_K a bgf:Constant ; bgf:hasSymbol "q_giEpi_K" ; bgf:hasValue "0.0203 mol"^^cdt:ucum .
:q_giEpi_W a bgf:Constant ; bgf:hasSymbol "q_giEpi_W" ; bgf:hasValue "0.14 L"^^cdt:ucum .

:c_gi_Na a bgf:Concentration ; bgf:hasSymbol "c_gi_Na" .
:c_giEpi_Na a bgf:Concentration ; bgf:hasSymbol "c_giEpi_Na" .
:c_giEpi_K a bgf:Concentration ; bgf:hasSymbol "c_giEpi_K" .
:c_vc_Na_L a bgf:Concentration ; bgf:hasSymbol "c_vc_Na_L" .
:c_vc_Na a bgf:Gain ; bgf:hasSymbol "c_vc_Na" ;
    bgf:parameterValue [ bgf:varName "k" ; bgf:hasSymbol "c_vc_Na_scale" ; bgf:hasValue "0.001 1"^^cdt:ucum ] .
:c_vc_K a bgf:Concentration ; bgf:hasSymbol "c_vc_K" .
:u_gi_osmotic a bgf:VantHoff ; bgf:hasSymbol "u_gi_osmotic" ;
    bgf:parameterValue [ bgf:varName "phi" ; bgf:hasSymbol "phi_gi" ; bgf:hasValue "1 1"^^cdt:ucum ] .
:u_vc_osmotic a bgf:VantHoff ; bgf:hasSymbol "u_vc_osmotic" ;
    bgf:parameterValue [ bgf:varName "phi" ; bgf:hasSymbol "phi_vc" ; bgf:hasValue "1 1"^^cdt:ucum ] .
:du_osm_gi a bgf:Difference ; bgf:hasSymbol "du_osm_gi" .
:v_gi_W_osm a bgf:Gain ; bgf:hasSymbol "v_gi_W_osm" ;
    bgf:parameterValue [ bgf:varName "k" ; bgf:hasSymbol "k_gi_W" ; bgf:hasValue "0.00023925 L2.s-1.J-1"^^cdt:ucum ] .
:v_gi_W_max a bgf:Rectifier ; bgf:hasSymbol "v_gi_W_max" .
:dq_gi_Na a bgf:Difference ; bgf:hasSymbol "dq_gi_Na" .
:v_gi_Na_lin a bgf:Gain ; bgf:hasSymbol "v_gi_Na_lin" ;
    bgf:parameterValue [ bgf:varName "k" ; bgf:hasSymbol "kK_gi_Na" ; bgf:hasValue "0.003 s-1"^^cdt:ucum ] .
:v_gi_Na_max a bgf:Rectifier ; bgf:hasSymbol "v_gi_Na_max" .

:s01 a bgf:SignalBond ; bgf:hasSource :gi_Na ; bgf:hasTarget :c_gi_Na ; bgf:signalInput "q_s" .
:s02 a bgf:SignalBond ; bgf:hasSource :gi_W ; bgf:hasTarget :c_gi_Na ; bgf:signalInput "q_w" .
:s03 a bgf:SignalBond ; bgf:hasSource :giEpi_Na ; bgf:hasTarget :c_giEpi_Na ; bgf:signalInput "q_s" .
:s04 a bgf:SignalBond ; bgf:hasSource :q_giEpi_W ; bgf:hasTarget :c_giEpi_Na ; bgf:signalInput "q_w" .
:s05 a bgf:SignalBond ; bgf:hasSource :q_giEpi_K ; bgf:hasTarget :c_giEpi_K ; bgf:signalInput "q_s" .
:s06 a bgf:SignalBond ; bgf:hasSource :q_giEpi_W ; bgf:hasTarget :c_giEpi_K ; bgf:signalInput "q_w" .
:s07 a bgf:SignalBond ; bgf:hasSource :q_vc_Na ; bgf:hasTarget :c_vc_Na_L ; bgf:signalInput "q_s" .
:s08 a bgf:SignalBond ; bgf:hasSource :q_vc_W ; bgf:hasTarget :c_vc_Na_L ; bgf:signalInput "q_w" .
:s09 a bgf:SignalBond ; bgf:hasSource :c_vc_Na_L ; bgf:hasTarget :c_vc_Na .
:s10 a bgf:SignalBond ; bgf:hasSource :q_vc_K ; bgf:hasTarget :c_vc_K ; bgf:signalInput "q_s" .
:s11 a bgf:SignalBond ; bgf:hasSource :q_vc_W ; bgf:hasTarget :c_vc_K ; bgf:signalInput "q_w" .
:s12 a bgf:SignalBond ; bgf:hasSource :c_gi_Na ; bgf:hasTarget :u_gi_osmotic .
:s13 a bgf:SignalBond ; bgf:hasSource :c_vc_Na ; bgf:hasTarget :u_vc_osmotic .
:s14 a bgf:SignalBond ; bgf:hasSource :u_vc_osmotic ; bgf:hasTarget :du_osm_gi ; bgf:signalInput "u_1" .
:s15 a bgf:SignalBond ; bgf:hasSource :u_gi_osmotic ; bgf:hasTarget :du_osm_gi ; bgf:signalInput "u_2" .
:s16 a bgf:SignalBond ; bgf:hasSource :du_osm_gi ; bgf:hasTarget :v_gi_W_osm .
:s17 a bgf:SignalBond ; bgf:hasSource :v_gi_W_osm ; bgf:hasTarget :v_gi_W_max .
:s18 a bgf:SignalBond ; bgf:hasSource :v_gi_W_max ; bgf:hasTarget :abs_W ; bgf:signalInput "v" .
:s19 a bgf:SignalBond ; bgf:hasSource :gi_Na ; bgf:hasTarget :dq_gi_Na ; bgf:signalInput "u_1" .
:s20 a bgf:SignalBond ; bgf:hasSource :giEpi_Na ; bgf:hasTarget :dq_gi_Na ; bgf:signalInput "u_2" .
:s21 a bgf:SignalBond ; bgf:hasSource :dq_gi_Na ; bgf:hasTarget :v_gi_Na_lin .
:s22 a bgf:SignalBond ; bgf:hasSource :v_gi_Na_lin ; bgf:hasTarget :v_gi_Na_max .
:s23 a bgf:SignalBond ; bgf:hasSource :v_gi_Na_max ; bgf:hasTarget :J_gi ; bgf:signalInput "J" .
:s24 a bgf:SignalBond ; bgf:hasSource :c_giEpi_Na ; bgf:hasTarget :NKE ; bgf:signalInput "c_Na_i" .
:s25 a bgf:SignalBond ; bgf:hasSource :c_vc_Na_L ; bgf:hasTarget :NKE ; bgf:signalInput "c_Na_o" .
:s26 a bgf:SignalBond ; bgf:hasSource :c_giEpi_K ; bgf:hasTarget :NKE ; bgf:signalInput "c_K_i" .
:s27 a bgf:SignalBond ; bgf:hasSource :c_vc_K ; bgf:hasTarget :NKE ; bgf:signalInput "c_K_o" .
:s28 a bgf:SignalBond ; bgf:hasSource :q_aldo ; bgf:hasTarget :aldo_scale .
:s29 a bgf:SignalBond ; bgf:hasSource :aldo_scale ; bgf:hasTarget :NKE ; bgf:modulates "k_NKE" .
