@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix tpl: <https://bg-rdf.org/templates/> .

@prefix : <#> .

# Renin secretion and the angiotensin cascade. Renin is secreted at k f_P(P) (q_ATII/q_ATII_0)^-B: a flow source
# whose value k is modulated by the product of a threshold scale of the renal perfusion pressure P (from outside the
# model) and a power law of Ang II. Renin turns angiotensinogen into Ang I by irreversible Michaelis-Menten kinetics,
# with renin's amount as the enzyme (a signal); ACE turns Ang I into Ang II; each is cleared.

:renin_secretion
    a bgf:BondgraphModel ;
    bgf:usesTemplate tpl:chemical.ttl, tpl:signal.ttl ;
    bgf:hasBondElement :Sf_renin, :q_renin, :Re_renin, :Se_renin,
                       :Sf_AGT, :q_AGT, :v1, :q_ATI, :v2, :q_ATII, :Re_ATII, :Se_ATII ;
    bgf:hasSignalBlock :P_renal, :f_P, :fb_ATII, :m_renin ;
    bgf:hasSignalBond :s1, :s2, :s3, :s4, :s5, :s6 .

:Sf_renin
    a bgf:ChemicalFlow ;
    bgf:hasSymbol "v_renin" ;
    bgf:hasValue "1e-15 mol/s"^^cdt:ucum .

:q_renin
    a bgf:ChemicalStorageNode ;
    bgf:hasSpecies "renin" ;
    bgf:hasValue "1.3e-12 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1e12 mol-1"^^cdt:ucum ] .

:Re_renin
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasValue "7.7e-16 mol/s"^^cdt:ucum ] .

:Se_renin
    a bgf:ChemicalPotential ;
    bgf:hasSymbol "Se" ; bgf:hasSpecies "renin_cleared" ;
    bgf:hasValue "-80000 J/mol"^^cdt:ucum .

:Sf_AGT
    a bgf:ChemicalFlow ;
    bgf:hasSymbol "v_AGT" ;
    bgf:hasValue "6e-11 mol/s"^^cdt:ucum .

:q_AGT
    a bgf:ChemicalStorageNode ;
    bgf:hasSpecies "AGT" ;
    bgf:hasValue "3e-6 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "3.3e5 mol-1"^^cdt:ucum ] .

:v1
    a bgf:MichaelisMentenReactionNode ;
    bgf:parameterValue [ bgf:varName "kcat" ; bgf:hasValue "1 s-1"^^cdt:ucum ] ,
                       [ bgf:varName "Km" ; bgf:hasValue "1.1 1"^^cdt:ucum ] ,
                       [ bgf:varName "a" ; bgf:hasSymbol "renin_activity" ; bgf:hasValue "1 1"^^cdt:ucum ] .

:q_ATI
    a bgf:ChemicalStorageNode ;
    bgf:hasSpecies "ATI" ;
    bgf:hasValue "1e-11 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1e10 mol-1"^^cdt:ucum ] .

:v2
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasValue "1e-11 mol/s"^^cdt:ucum ] .

:q_ATII
    a bgf:ChemicalStorageNode ;
    bgf:hasSpecies "ATII" ;
    bgf:hasValue "1.5e-11 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1e10 mol-1"^^cdt:ucum ] .

:Re_ATII
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasValue "3.3e-12 mol/s"^^cdt:ucum ] .

:Se_ATII
    a bgf:ChemicalPotential ;
    bgf:hasSymbol "Se" ; bgf:hasSpecies "ATII_cleared" ;
    bgf:hasValue "-80000 J/mol"^^cdt:ucum .

:b1 bgf:hasSource :Sf_renin ; bgf:hasTarget :q_renin .
:b2 bgf:hasSource :q_renin ; bgf:hasTarget :Re_renin .
:b3 bgf:hasSource :Re_renin ; bgf:hasTarget :Se_renin .
:b4 bgf:hasSource :Sf_AGT ; bgf:hasTarget :q_AGT .
:b5 bgf:hasSource :q_AGT ; bgf:hasTarget :v1 .
:b6 bgf:hasSource :v1 ; bgf:hasTarget :q_ATI .
:b7 bgf:hasSource :q_ATI ; bgf:hasTarget :v2 .
:b8 bgf:hasSource :v2 ; bgf:hasTarget :q_ATII .
:b9 bgf:hasSource :q_ATII ; bgf:hasTarget :Re_ATII .
:b10 bgf:hasSource :Re_ATII ; bgf:hasTarget :Se_ATII .

# Signals

:P_renal
    a bgf:SignalInputPort ;
    bgf:hasSymbol "P_renal" ;
    bgf:portType "renal_perfusion_pressure_port" ;
    bgf:hasValue "12 kPa"^^cdt:ucum .

:f_P
    a bgf:LogisticScale ;
    bgf:hasSymbol "f_P" ;
    bgf:parameterValue [ bgf:varName "a" ; bgf:hasValue "4 1"^^cdt:ucum ] ,
                       [ bgf:varName "u_th" ; bgf:hasSymbol "P_th" ; bgf:hasValue "11.5 kPa"^^cdt:ucum ] ,
                       [ bgf:varName "w" ; bgf:hasSymbol "P_w" ; bgf:hasValue "0.8 kPa"^^cdt:ucum ] .

:fb_ATII
    a bgf:PowerLaw ;
    bgf:hasSymbol "fb_ATII" ;
    bgf:parameterValue [ bgf:varName "u_ref" ; bgf:hasSymbol "q_ATII_0" ; bgf:hasValue "1.5e-11 mol"^^cdt:ucum ] ,
                       [ bgf:varName "n" ; bgf:hasSymbol "minus_B" ; bgf:hasValue "-0.95 1"^^cdt:ucum ] .

:m_renin
    a bgf:Product ;
    bgf:hasSymbol "m_renin" .

:s1 a bgf:SignalBond ; bgf:hasSource :P_renal ; bgf:hasTarget :f_P .
:s2 a bgf:SignalBond ; bgf:hasSource :q_ATII ; bgf:hasTarget :fb_ATII .
:s3 a bgf:SignalBond ; bgf:hasSource :f_P ; bgf:hasTarget :m_renin ; bgf:signalInput "u_1" .
:s4 a bgf:SignalBond ; bgf:hasSource :fb_ATII ; bgf:hasTarget :m_renin ; bgf:signalInput "u_2" .
:s5 a bgf:SignalBond ; bgf:hasSource :m_renin ; bgf:hasTarget :Sf_renin ; bgf:modulates "v" .
:s6 a bgf:SignalBond ; bgf:hasSource :q_renin ; bgf:hasTarget :v1 ; bgf:signalInput "E" .
